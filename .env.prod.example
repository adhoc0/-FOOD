# Production için: bu dosyayı .env.prod olarak kopyalayın (git'e eklenmez).
DOMAIN=ornek-alan-adi.com
LETSENCRYPT_EMAIL=admin@ornek-alan-adi.com

SECRET_KEY=replace-with-a-random-secret-of-at-least-50-characters
ADMIN_URL=gizli-yonetim-yolu/
DEFAULT_FROM_EMAIL=noreply@ornek-alan-adi.com

DB_NAME=food_db
DB_USER=food
DB_PASSWORD=replace-with-a-strong-password

# Yedekleme: kaç gün saklanacağı (varsayılan 14)
BACKUP_RETENTION_DAYS=14

# Hata izleme (isteğe bağlı; boşsa kapalı)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
